// Prisma Schema for TripMate – NeonDB PostgreSQL
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum BookingType {
  FLIGHT
  HOTEL
  PACKAGE
  TRIP_PLAN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VoucherStatus {
  ACTIVE
  REDEEMED
  EXPIRED
}

enum HotelCategory {
  BUDGET
  STANDARD
  PREMIUM
  LUXURY
}

model User {
  id            String          @id @default(uuid())
  name          String
  email         String          @unique
  password      String
  phone         String?
  role          Role            @default(CUSTOMER)
  bookings      Booking[]
  reviews       Review[]
  vouchers      RewardVoucher[]
  tripPlans     TripPlan[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([email])
}

model Booking {
  id                 String          @id @default(uuid())
  bookingReference   String          @unique
  userId             String?
  user               User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  bookingType        BookingType     @default(PACKAGE)
  fullName           String
  email              String
  phone              String
  departureCity      String          @default("Dhaka")
  destination        String          @default("Dubai, UAE")
  departureAirport   String          @default("DAC")
  arrivalAirport     String          @default("DXB") // DXB or DWC
  departureDate      DateTime
  returnDate         DateTime?
  numberOfTravelers  Int             @default(1)
  selectedFlightId   String?
  selectedHotelId    String?
  selectedPackage    String?
  totalEstimatedCost Float           @default(0)
  currency           String          @default("BDT")
  specialRequests    String?
  bookingStatus      BookingStatus   @default(PENDING)
  voucherCode        String?
  review             Review?
  flightBookings     FlightBooking[]
  hotelBookings      HotelBooking[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([bookingReference])
  @@index([email])
  @@index([userId])
}

model Flight {
  id               String          @id @default(uuid())
  flightNumber     String          @unique
  airlineName      String
  airlineLogo      String?
  departureAirport String          // DAC
  arrivalAirport   String          // DXB or DWC
  departureTime    String
  arrivalTime      String
  duration         String
  stops            String          @default("Non-stop")
  priceEconomy     Float
  priceBusiness    Float
  cabinClass       String          @default("Economy")
  isSample         Boolean         @default(true)
  flightBookings   FlightBooking[]
  createdAt        DateTime        @default(now())
}

model FlightBooking {
  id              String    @id @default(uuid())
  bookingId       String
  booking         Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  flightId        String
  flight          Flight    @relation(fields: [flightId], references: [id])
  passengersCount Int       @default(1)
  cabinClass      String    @default("Economy")
  createdAt       DateTime  @default(now())
}

model Hotel {
  id              String         @id @default(uuid())
  name            String
  location        String
  category        HotelCategory  @default(STANDARD)
  pricePerNight   Float
  rating          Float          @default(4.5)
  image           String
  facilities      String[]
  isPartnerHotel  Boolean        @default(false)
  discountPercent Int            @default(20)
  description     String
  hotelBookings   HotelBooking[]
  createdAt       DateTime       @default(now())
}

model HotelBooking {
  id          String    @id @default(uuid())
  bookingId   String
  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  hotelId     String
  hotel       Hotel     @relation(fields: [hotelId], references: [id])
  checkIn     DateTime
  checkOut    DateTime
  roomType    String    @default("Deluxe Room")
  guestsCount Int       @default(2)
  totalPrice  Float
  voucherId   String?
  createdAt   DateTime  @default(now())
}

model TravelPackage {
  id             String    @id @default(uuid())
  name           String
  duration       String
  pricePerPerson Float
  originalPrice  Float?
  departure      String    @default("Dhaka, Bangladesh")
  destination    String    @default("Dubai, UAE")
  description    String
  itinerary      Json
  included       String[]
  excluded       String[]
  isDemoEstimate Boolean   @default(true)
  createdAt      DateTime  @default(now())
}

model TripPlan {
  id              String    @id @default(uuid())
  userId          String?
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  destination     String    @default("Dubai, UAE")
  arrivalAirport  String    @default("DXB")
  departureDate   DateTime
  returnDate      DateTime
  travelers       Int       @default(2)
  budget          Float
  totalCost       Float
  flightCost      Float
  hotelCost       Float
  foodCost        Float
  transportCost   Float
  activityCost    Float
  remainingBudget Float
  budgetStatus    String    // WITHIN_BUDGET, SLIGHTLY_OVER, OVER_BUDGET
  recommendations Json?
  createdAt       DateTime  @default(now())
}

model Review {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingId      String        @unique
  booking        Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  rating         Int           @default(5)
  reviewText     String
  approvalStatus ReviewStatus  @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId])
  @@index([approvalStatus])
}

model RewardVoucher {
  id                 String        @id @default(uuid())
  userId             String
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  voucherCode        String        @unique
  discountPercentage Int           @default(20)
  partnerHotelId     String
  expiryDate         DateTime
  redemptionStatus   VoucherStatus @default(ACTIVE)
  redeemedAt         DateTime?
  createdAt          DateTime      @default(now())

  @@index([userId])
  @@index([voucherCode])
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    String   @default("NEW")
  createdAt DateTime @default(now())
}
